{
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "tailwindcss-language-server",
        "oxfmt",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "..."]
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxfmt", "..."]
    },
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxlint", "oxfmt", "..."],
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxlint", "oxfmt", "..."],
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["oxlint", "oxfmt", "..."],
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "experimental": {
            "configFile": "./src/globals.css"
          }
        }
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "typescript": {
          "tsdk": "./node_modules/typescript/lib"
        }
      }
    }
  },
  "file_scan_exclusions": [
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings"
  ],
  "format_on_save": "on"
}
