{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["docs/**"],
  "ignoreExportsUsedInFile": true,
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "binaries",
    "unresolved"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "tailwind-scrollbar",
    "babel-plugin-react-compiler",
    "geckodriver",
    "shadcn",
    "@opencode-ai/plugin"
  ],
  "ignoreBinaries": ["geckodriver", "preview"],
  "workspaces": {
    ".": {
      "entry": [
        "src/entrypoints/**/*.{ts,tsx}",
        "config/**/*.ts",
        "tools/*.ts",
        "wxt.config.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "config/**/*.ts", "tools/**/*.ts"]
    },
    "packages/olc": {
      "entry": [
        "src/index.ts",
        "src/cli.ts",
        "src/backends/opencode/plugin/bridge.ts"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
