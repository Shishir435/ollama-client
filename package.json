{
  "name": "ollama-client",
  "displayName": "Ollama Client - Local AI Chat for Ollama, LM Studio, llama.cpp",
  "version": "0.13.1",
  "description": "Local-first browser extension for private LLM chat with Ollama, LM Studio, llama.cpp, and other local or remote providers, with local RAG, web search, and page context.",
  "author": "Shishir Chaurasiya",
  "keywords": [
    "local llm chrome extension",
    "ollama client",
    "offline ai assistant",
    "ollama browser extension",
    "lm studio integration",
    "llama.cpp browser integration",
    "rag with local llms",
    "privacy-first ai",
    "local ai chat",
    "offline ai chat",
    "self-hosted ai",
    "private ai chat",
    "open-source ai",
    "browser ai assistant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shishir435/ollama-client.git"
  },
  "homepage": "https://www.ollamaclient.in",
  "bugs": {
    "url": "https://github.com/Shishir435/ollama-client/issues"
  },
  "scripts": {
    "dev": "pnpm generate:resources && WXT_OUTPUT_DIR=build/chrome-mv3-dev wxt",
    "build": "pnpm generate:resources && WXT_OUTPUT_DIR=build/chrome-mv3-prod wxt build",
    "docs:dev": "pnpm docs:generate && pnpm --dir docs dev",
    "docs:build": "pnpm docs:generate && pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview",
    "docs:generate": "pnpm exec tsx tools/generate-docs.ts && pnpm exec tsx tools/generate-llms-docs.ts",
    "package": "pnpm generate:resources && WXT_OUTPUT_DIR=build/chrome-mv3-prod wxt zip",
    "dev:firefox": "pnpm generate:resources && WXT_OUTPUT_DIR=build/firefox-mv2-dev wxt -b firefox --mv2",
    "build:firefox": "pnpm generate:resources && WXT_OUTPUT_DIR=build/firefox-mv2-prod wxt build -b firefox --mv2 --mode production",
    "package:firefox": "pnpm generate:resources && WXT_OUTPUT_DIR=build/firefox-mv2-prod wxt zip -b firefox --mv2 --mode production",
    "verify:browser-smoke": "pnpm exec tsx tools/verify-browser-smoke.ts",
    "verify:release": "pnpm verify && pnpm verify:browser-smoke && pnpm docs:build && pnpm e2e:release",
    "verify:local-browsers": "pnpm exec tsx tools/verify-local-browsers-sequential.ts",
    "verify:browser-automation": "pnpm verify:browser-smoke && pnpm exec tsx tools/verify-browser-automation-local.ts",
    "benchmark:persistence": "tsx tools/benchmark-sqlite-persistence.ts",
    "benchmark:build": "pnpm generate:resources && WXT_BENCHMARK=1 WXT_OUTPUT_DIR=build/chrome-mv3-benchmark wxt build",
    "benchmark:build:firefox": "pnpm generate:resources && WXT_BENCHMARK=1 WXT_OUTPUT_DIR=build/firefox-mv2-benchmark wxt build -b firefox --mv2 --mode production",
    "bundle:report": "tsx tools/check-bundle-size.ts",
    "bundle:check": "tsx tools/check-bundle-size.ts --check",
    "bundle:check:firefox": "tsx tools/check-bundle-size.ts build/firefox-mv2-prod --check",
    "benchmark:browser": "tsx tools/benchmark-browser-persistence.ts",
    "spike:build": "pnpm generate:resources && WXT_BENCHMARK=1 WXT_SPIKE_OWNER=1 WXT_OUTPUT_DIR=build/chrome-mv3-spike wxt build",
    "spike:build:firefox": "pnpm generate:resources && WXT_BENCHMARK=1 WXT_SPIKE_OWNER=1 WXT_OUTPUT_DIR=build/firefox-mv2-spike wxt build -b firefox --mv2 --mode production",
    "spike:owner-gates": "tsx tools/spike-owner-gates.ts",
    "spike:sw-termination": "tsx tools/spike-sw-termination.ts",
    "spike:firefox-owner-gates": "tsx tools/spike-firefox-owner-gates.ts",
    "verify:ci-parity": "tsx tools/verify-ci-parity.ts",
    "verify:opfs-migration": "tsx tools/verify-opfs-migration.ts",
    "verify:firefox-opfs-migration": "tsx tools/verify-firefox-opfs-migration.ts",
    "verify:sw-turn-recovery": "tsx tools/verify-sw-turn-recovery.ts",
    "e2e": "pnpm e2e:build && pnpm e2e:chromium:critical",
    "e2e:build": "pnpm build && pnpm benchmark:build",
    "e2e:build:release": "pnpm build && pnpm build:firefox && pnpm benchmark:build && pnpm benchmark:build:firefox",
    "e2e:release": "pnpm e2e:build:release && pnpm e2e:chromium:critical && pnpm verify:sw-turn-recovery && pnpm verify:opfs-migration && pnpm verify:firefox-opfs-migration",
    "e2e:chromium": "playwright test",
    "e2e:chromium:critical": "playwright test --grep @critical",
    "e2e:headed": "E2E_HEADFUL=1 playwright test --grep @critical",
    "e2e:report": "playwright show-report artifacts/e2e/html",
    "verify": "pnpm typecheck && pnpm lint:check && pnpm check:dead && pnpm check:i18n && pnpm test:run && pnpm check:generated && pnpm check:compatibility",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:check": "biome check .",
    "test:related": "vitest related --run",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm typecheck:packages && tsc6 -p tsconfig.json --noEmit",
    "typecheck:packages": "pnpm typecheck:contracts && pnpm typecheck:runtime-core && pnpm typecheck:chat-runtime && pnpm typecheck:olc",
    "typecheck:contracts": "tsc6 -p packages/contracts/tsconfig.json --noEmit",
    "typecheck:runtime-core": "tsc6 -p packages/runtime-core/tsconfig.json --noEmit",
    "typecheck:chat-runtime": "tsc6 -p packages/chat-runtime/tsconfig.json --noEmit",
    "typecheck:olc": "tsc6 -p packages/olc/tsconfig.json",
    "check:dead": "knip --no-config-hints",
    "audit": "pnpm audit",
    "clean": "rm -rf build .plasmo .wxt .output node_modules",
    "prepare": "husky",
    "generate:resources": "pnpm exec tsx tools/generate-i18n-resources.ts",
    "check:generated": "pnpm generate:resources && git diff --exit-code -- public/_locales",
    "check:i18n": "pnpm exec tsx tools/check-i18n-drift.ts --strict",
    "check:compatibility": "node tools/check-compatibility-ledger.mjs",
    "proxy": "pnpm exec tsx packages/olc/src/cli.ts",
    "proxy:debug": "pnpm exec tsx packages/olc/src/cli.ts --debug",
    "proxy:build": "pnpm --filter @ollama-client/olc build",
    "proxy:bundle": "pnpm --filter @ollama-client/olc bundle"
  },
  "dependencies": {
    "@ollama-client/chat-runtime": "workspace:*",
    "@ollama-client/contracts": "workspace:*",
    "@ollama-client/runtime-core": "workspace:*",
    "@base-ui/react": "^1.5.0",
    "@mozilla/readability": "^0.6.0",
    "@plasmohq/storage": "^1.15.0",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "d3-dsv": "^3.0.1",
    "defuddle": "0.9.0",
    "dexie": "^4.4.2",
    "dexie-export-import": "^4.4.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "hnsw": "^1.1.1",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "0.474.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.3.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-copy-code": "^0.1.3",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.8",
    "react-virtuoso": "^4.18.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "turndown": "^7.2.4",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "1.60.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "0.0.258",
    "@types/d3-dsv": "^3.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.11",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.6",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "^4.1.7",
    "babel-plugin-react-compiler": "1.0.0",
    "fake-indexeddb": "^6.2.5",
    "geckodriver": "^6.1.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "knip": "^6.24.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.60.0",
    "postcss": "8.5.18",
    "rollup-plugin-visualizer": "^6.0.11",
    "selenium-webdriver": "^4.27.0",
    "shadcn": "^4.12.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "4.3.0",
    "tailwind-scrollbar": "^4.0.2",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.7",
    "wxt": "^0.20.26"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "bash -lc \"pnpm typecheck\"",
      "pnpm format:fix",
      "pnpm lint:fix",
      "pnpm test:related"
    ]
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=22.12.0"
  }
}
