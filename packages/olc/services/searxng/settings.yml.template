use_default_settings: true

general:
  debug: false
  instance_name: "Ollama Client Local Search"

search:
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  base_url: "http://localhost:__HOST_PORT__/"
  secret_key: "__SECRET_KEY__"
  public_instance: false

valkey:
  url: redis://valkey:6379/0
